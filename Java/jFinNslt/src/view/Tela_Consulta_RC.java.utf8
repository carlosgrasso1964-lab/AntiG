    private void jButtonPesquisarActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_jButtonPesquisarActionPerformed



        // === VALIDA\\u00c7\\u00c3O DOS CAMPOS DE DATA ===

        if (jFormattedTextFieldDataIni.getText().trim().length() == 4) {

            JOptionPane.showMessageDialog(null, "Atenção! Favor preencher o campo de data inicial.");

            return;

        }

        if (jFormattedTextFieldDataFim.getText().trim().length() == 4) {

            JOptionPane.showMessageDialog(null, "Atenção! Favor preencher o campo de data final.");

            return;

        }



        double saldoInicialPeriodo = 0;

        double pegaSaldoFinal = 0;



        // === DECLARA\\u00c7\\u00d5ES FORA DO TRY ===

        Connection con = null;

        PreparedStatement stmt = null, stmtReceitas = null, stmtDespesas = null;

        PreparedStatement stmtEmprestimosObtidos = null, stmtEmprestimosPagos = null;

        PreparedStatement stmtSaldo = null;

        ResultSet rs = null, rsReceitas = null, rsDespesas = null;

        ResultSet rsEmprestimosObtidos = null, rsEmprestimosPagos = null;

        ResultSet rsSaldo = null;



        try {

            // === FORMATAR DATAS ===

            SimpleDateFormat formatoEntrada = new SimpleDateFormat("dd/MM/yyyy");

            SimpleDateFormat formatoSaida = new SimpleDateFormat("yyyy-MM-dd");

            String dataIniStr = jFormattedTextFieldDataIni.getText().trim();

            String dataFimStr = jFormattedTextFieldDataFim.getText().trim();

            Date dataIni = formatoEntrada.parse(dataIniStr);

            Date dataFim = formatoEntrada.parse(dataFimStr);

            String dataIniFormatada = formatoSaida.format(dataIni);

            String dataFimFormatada = formatoSaida.format(dataFim);



            // === FORMATADOR DE MOEDA ===

            DecimalFormatSymbols symbols = new DecimalFormatSymbols();

            symbols.setDecimalSeparator(',');

            symbols.setGroupingSeparator('.');

            DecimalFormat dfCurrency = new DecimalFormat("#,##0.00", symbols);



            // === ABRIR CONEX\\u00c3O ===

            conexao.abrirConexao();

            con = conexao.getConexao();



            // === 1. BUSCAR SALDO ANTERIOR (ATé O DIA ANTES DO PERÍODO) ===

            Calendar cal = Calendar.getInstance();

            cal.setTime(dataIni);

            cal.add(Calendar.DAY_OF_MONTH, -1);

            String dataDiaAnterior = formatoSaida.format(cal.getTime());



            // Variáveis que vão receber os saldos transportados

            double saldoCaixaBancoAnterior = 0.0;     // Saldo LIMPO (sem empréstimo)

            double saldoEmprestimoAnterior = 0.0;     // Passivo de empréstimo (negativo)



            // === DECISÃO: Período já passou ou é futuro? ===

            Date dataHoje = new Date();

            boolean periodoNoPassado = cal.getTime().before(dataHoje); // até dia anterior < hoje?



            if (periodoNoPassado) {

                // === PERÍODO NO PASSADO: usa apenas movimentos efetivados (dtApr não nulo) ===

                String sqlSaldoCaixa

                        = "SELECT COALESCE(SUM(Valor), 0) AS saldo "

                        + "FROM tbmovimento "

                        + "WHERE dtlancto <= ? "

                        + "  AND vrecurso IN ('1.001.001', '1.001.002', '1.003.001') "

                        + "  AND recurso NOT IN ('0079', '0022') "

                        + "  AND dtApr IS NOT NULL AND TRIM(COALESCE(dtApr,'')) <> '';";



                String sqlSaldoEmprestimo

                        = "SELECT COALESCE(SUM(Valor), 0) AS saldo FROM tbmovimento WHERE recurso = '0080' AND dtlancto <= ?;";



                stmtSaldo = con.prepareStatement(sqlSaldoCaixa);

                stmtSaldo.setString(1, dataDiaAnterior);

                rsSaldo = stmtSaldo.executeQuery();

                if (rsSaldo.next()) {

                    saldoCaixaBancoAnterior = rsSaldo.getDouble("saldo");

                    //System.out.println("Saldo Caixa Banco Anterior: " + saldoCaixaBancoAnterior);

                }

                rsSaldo.close();

                stmtSaldo.close();



                stmtSaldo = con.prepareStatement(sqlSaldoEmprestimo);

                stmtSaldo.setString(1, dataDiaAnterior);

                rsSaldo = stmtSaldo.executeQuery();

                if (rsSaldo.next()) {

                    saldoEmprestimoAnterior = rsSaldo.getDouble("saldo");

                    //System.out.println("Saldo Caixa Banco Anterior: " + saldoEmprestimoAnterior);

                }



            } else {

                // === PERÍODO ATUAL OU FUTURO: projeção confirmada + empréstimos até o dia anterior ===



                // C1 - Saldo efetivo consolidado (caixa/banco + parcelas recebidas)

                String sqlC1 = "SELECT COALESCE(SUM(Valor), 0) AS saldo "

                        + "FROM tbmovimento "

                        + "WHERE vrecurso IN ('1.001.001','1.001.002','1.003.001','2.001.004') "

                        + "  AND dtlancto <= ? "

                        + "  AND dtApr IS NOT NULL AND TRIM(COALESCE(dtApr,'')) <> '' "

                        + "  AND recurso NOT IN ('0079','0022');";



                // C2 - Projeções confirmadas (Prev='V') com vencimento até dia anterior

                String sqlC2 = "SELECT COALESCE(SUM(Valor), 0) AS saldo "

                        + "FROM tbmovimento "

                        + "WHERE vrecurso IN ('1.002.001','2.001.002','2.001.003') "

                        + "AND dtVcto <= ? AND statusMov = '';";



                // C4 - Empréstimos obtidos (recurso 0080)

                String sqlC4 = "SELECT COALESCE(SUM(Valor), 0) AS saldo FROM tbmovimento WHERE recurso = '0080' AND dtlancto <= ?;";



                // Executa C1

                stmtSaldo = con.prepareStatement(sqlC1);

                stmtSaldo.setString(1, formatoSaida.format(dataHoje)); // até hoje

                rsSaldo = stmtSaldo.executeQuery();

                if (rsSaldo.next()) {

                    saldoCaixaBancoAnterior += rsSaldo.getDouble("saldo");

                    //System.out.println("Saldo Caixa Banco Anterior (Futuro) até hoje sqlC1: " + saldoCaixaBancoAnterior);

                }

                rsSaldo.close();

                stmtSaldo.close();



                // Executa C2

                stmtSaldo = con.prepareStatement(sqlC2);

                stmtSaldo.setString(1, dataDiaAnterior);

                rsSaldo = stmtSaldo.executeQuery();

                if (rsSaldo.next()) {

                    saldoCaixaBancoAnterior += rsSaldo.getDouble("saldo");

                    //System.out.println("Saldo Caixa Banco Anterior (Futuro) sqlC2 depois de hoje: " + saldoCaixaBancoAnterior);

                }

                rsSaldo.close();

                stmtSaldo.close();



                // Executa C4 - Empréstimos

                stmtSaldo = con.prepareStatement(sqlC4);

                stmtSaldo.setString(1, dataDiaAnterior);

                rsSaldo = stmtSaldo.executeQuery();

                if (rsSaldo.next()) {

                    saldoEmprestimoAnterior = rsSaldo.getDouble("saldo");

                    //System.out.println("Saldo Empréstimos: " + saldoEmprestimoAnterior);

                    saldoEmprestimoAnterior = saldoEmprestimoAnterior * -1;

                    //System.out.println("Mudando sinal Empréstimos: " + saldoEmprestimoAnterior);

                    saldoCaixaBancoAnterior += rsSaldo.getDouble("saldo");

                    //System.out.println("Saldo Caixa deduzido Empréstimos: " + saldoCaixaBancoAnterior);



                }

            }



            // === ATRIBUIÇÃO FINAL DAS VARIÁVEIS GLOBAIS/DE CLASSE ===

            saldoInicialPeriodo = saldoCaixaBancoAnterior;     // Saldo LIMPO

            saldoInicialEmprestimo = saldoEmprestimoAnterior;     // Saldo de empréstimo (geralmente negativo)



            // Atualiza também o transporte (caso esteja abrindo o mesmo período novamente)

            // === 2. CONSULTA PRINCIPAL (CONTAS) ===

            String sql = "SELECT nome_C AS Contas, "

                    + "SUM(CASE WHEN strftime('%m', dtVcto) = '01' THEN Valor ELSE 0 END) AS janeiro, "

                    + "SUM(CASE WHEN strftime('%m', dtVcto) = '02' THEN Valor ELSE 0 END) AS fevereiro, "

                    + "SUM(CASE WHEN strftime('%m', dtVcto) = '03' THEN Valor ELSE 0 END) AS marco, "

                    + "SUM(CASE WHEN strftime('%m', dtVcto) = '04' THEN Valor ELSE 0 END) AS abril, "

                    + "SUM(CASE WHEN strftime('%m', dtVcto) = '05' THEN Valor ELSE 0 END) AS maio, "

                    + "SUM(CASE WHEN strftime('%m', dtVcto) = '06' THEN Valor ELSE 0 END) AS junho, "

                    + "SUM(CASE WHEN strftime('%m', dtVcto) = '07' THEN Valor ELSE 0 END) AS julho, "

                    + "SUM(CASE WHEN strftime('%m', dtVcto) = '08' THEN Valor ELSE 0 END) AS agosto, "

                    + "SUM(CASE WHEN strftime('%m', dtVcto) = '09' THEN Valor ELSE 0 END) AS setembro, "

                    + "SUM(CASE WHEN strftime('%m', dtVcto) = '10' THEN Valor ELSE 0 END) AS outubro, "

                    + "SUM(CASE WHEN strftime('%m', dtVcto) = '11' THEN Valor ELSE 0 END) AS novembro, "

                    + "SUM(CASE WHEN strftime('%m', dtVcto) = '12' THEN Valor ELSE 0 END) AS dezembro, "

                    + "SUM(CASE WHEN Valor != 0 THEN Valor ELSE 0 END) AS total "

                    + "FROM viewmovrd "

                    + "WHERE dtVcto BETWEEN ? AND ? AND nome_P <> 'NULO' "

                    + "AND ((classif NOT IN ('3.003.005', '4.008.011')) "

                    + " OR (classif = '4.008.011' AND (dtApr IS NULL OR TRIM(dtApr) = ''))) "

                    + "GROUP BY nome_C ORDER BY nome_C;";



            stmt = con.prepareStatement(sql);

            stmt.setString(1, dataIniFormatada);

            stmt.setString(2, dataFimFormatada);

            rs = stmt.executeQuery();



            // === LIMPAR E CONFIGURAR TABELA ===

            DefaultTableModel modelo = (DefaultTableModel) jTablePesquisa.getModel();

            modelo.setNumRows(0);

            jTablePesquisa.setAutoResizeMode(JTable.AUTO_RESIZE_OFF);

            jTablePesquisa.getColumn(jTablePesquisa.getColumnName(0)).setPreferredWidth(320);

            for (int i = 1; i <= 12; i++) {

                jTablePesquisa.getColumn(jTablePesquisa.getColumnName(i)).setPreferredWidth(70);

            }

            jTablePesquisa.getColumn(jTablePesquisa.getColumnName(13)).setPreferredWidth(90);



            DefaultTableCellRenderer rightRenderer = new DefaultTableCellRenderer();

            rightRenderer.setHorizontalAlignment(SwingConstants.RIGHT);

            for (int i = 1; i < jTablePesquisa.getColumnCount(); i++) {

                jTablePesquisa.getColumnModel().getColumn(i).setCellRenderer(rightRenderer);

            }



            // === 5. CONSULTAS DE RECEITAS, DESPESAS E EMPRÉSTIMOS ===

            String queryReceitas = "SELECT "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '01' AND Valor > 0 AND classif LIKE '3.%' AND classif != '3.003.005' THEN Valor ELSE 0 END), 2) AS janeiro,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '02' AND Valor > 0 AND classif LIKE '3.%' AND classif != '3.003.005' THEN Valor ELSE 0 END), 2) AS fevereiro,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '03' AND Valor > 0 AND classif LIKE '3.%' AND classif != '3.003.005' THEN Valor ELSE 0 END), 2) AS marco,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '04' AND Valor > 0 AND classif LIKE '3.%' AND classif != '3.003.005' THEN Valor ELSE 0 END), 2) AS abril,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '05' AND Valor > 0 AND classif LIKE '3.%' AND classif != '3.003.005' THEN Valor ELSE 0 END), 2) AS maio,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '06' AND Valor > 0 AND classif LIKE '3.%' AND classif != '3.003.005' THEN Valor ELSE 0 END), 2) AS junho,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '07' AND Valor > 0 AND classif LIKE '3.%' AND classif != '3.003.005' THEN Valor ELSE 0 END), 2) AS julho,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '08' AND Valor > 0 AND classif LIKE '3.%' AND classif != '3.003.005' THEN Valor ELSE 0 END), 2) AS agosto,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '09' AND Valor > 0 AND classif LIKE '3.%' AND classif != '3.003.005' THEN Valor ELSE 0 END), 2) AS setembro,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '10' AND Valor > 0 AND classif LIKE '3.%' AND classif != '3.003.005' THEN Valor ELSE 0 END), 2) AS outubro,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '11' AND Valor > 0 AND classif LIKE '3.%' AND classif != '3.003.005' THEN Valor ELSE 0 END), 2) AS novembro,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '12' AND Valor > 0 AND classif LIKE '3.%' AND classif != '3.003.005' THEN Valor ELSE 0 END), 2) AS dezembro,"

                    + "ROUND(SUM(CASE WHEN Valor > 0 AND classif LIKE '3.%' AND classif != '3.003.005' THEN Valor ELSE 0 END), 2) AS total_receitas "

                    + "FROM viewmovrd WHERE dtVcto BETWEEN ? AND ? AND nome_P <> 'NULO';";



            stmtReceitas = con.prepareStatement(queryReceitas);

            stmtReceitas.setString(1, dataIniFormatada);

            stmtReceitas.setString(2, dataFimFormatada);

            rsReceitas = stmtReceitas.executeQuery();



            String queryDespesas = "SELECT "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '01' AND Valor < 0 AND classif LIKE '4.%' AND classif != '4.008.011' THEN Valor ELSE 0 END), 2) AS janeiro,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '02' AND Valor < 0 AND classif LIKE '4.%' AND classif != '4.008.011' THEN Valor ELSE 0 END), 2) AS fevereiro,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '03' AND Valor < 0 AND classif LIKE '4.%' AND classif != '4.008.011' THEN Valor ELSE 0 END), 2) AS marco,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '04' AND Valor < 0 AND classif LIKE '4.%' AND classif != '4.008.011' THEN Valor ELSE 0 END), 2) AS abril,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '05' AND Valor < 0 AND classif LIKE '4.%' AND classif != '4.008.011' THEN Valor ELSE 0 END), 2) AS maio,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '06' AND Valor < 0 AND classif LIKE '4.%' AND classif != '4.008.011' THEN Valor ELSE 0 END), 2) AS junho,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '07' AND Valor < 0 AND classif LIKE '4.%' AND classif != '4.008.011' THEN Valor ELSE 0 END), 2) AS julho,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '08' AND Valor < 0 AND classif LIKE '4.%' AND classif != '4.008.011' THEN Valor ELSE 0 END), 2) AS agosto,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '09' AND Valor < 0 AND classif LIKE '4.%' AND classif != '4.008.011' THEN Valor ELSE 0 END), 2) AS setembro,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '10' AND Valor < 0 AND classif LIKE '4.%' AND classif != '4.008.011' THEN Valor ELSE 0 END), 2) AS outubro,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '11' AND Valor < 0 AND classif LIKE '4.%' AND classif != '4.008.011' THEN Valor ELSE 0 END), 2) AS novembro,"

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '12' AND Valor < 0 AND classif LIKE '4.%' AND classif != '4.008.011' THEN Valor ELSE 0 END), 2) AS dezembro,"

                    + "ROUND(SUM(CASE WHEN Valor < 0 AND classif LIKE '4.%' AND classif != '4.008.011' THEN Valor ELSE 0 END), 2) AS total_despesas "

                    + "FROM viewmovrd WHERE dtVcto BETWEEN ? AND ? AND nome_P <> 'NULO';";



            stmtDespesas = con.prepareStatement(queryDespesas);

            stmtDespesas.setString(1, dataIniFormatada);

            stmtDespesas.setString(2, dataFimFormatada);

            rsDespesas = stmtDespesas.executeQuery();



            String queryEmprestimosObtidos = "SELECT "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '01' AND classif = '3.003.005' THEN ABS(Valor) ELSE 0 END), 2) AS janeiro, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '02' AND classif = '3.003.005' THEN ABS(Valor) ELSE 0 END), 2) AS fevereiro, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '03' AND classif = '3.003.005' THEN ABS(Valor) ELSE 0 END), 2) AS marco, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '04' AND classif = '3.003.005' THEN ABS(Valor) ELSE 0 END), 2) AS abril, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '05' AND classif = '3.003.005' THEN ABS(Valor) ELSE 0 END), 2) AS maio, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '06' AND classif = '3.003.005' THEN ABS(Valor) ELSE 0 END), 2) AS junho, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '07' AND classif = '3.003.005' THEN ABS(Valor) ELSE 0 END), 2) AS julho, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '08' AND classif = '3.003.005' THEN ABS(Valor) ELSE 0 END), 2) AS agosto, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '09' AND classif = '3.003.005' THEN ABS(Valor) ELSE 0 END), 2) AS setembro, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '10' AND classif = '3.003.005' THEN ABS(Valor) ELSE 0 END), 2) AS outubro, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '11' AND classif = '3.003.005' THEN ABS(Valor) ELSE 0 END), 2) AS novembro, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '12' AND classif = '3.003.005' THEN ABS(Valor) ELSE 0 END), 2) AS dezembro, "

                    + "ROUND(SUM(CASE WHEN classif = '3.003.005' THEN ABS(Valor) ELSE 0 END), 2) AS total_emprestimos_obtidos "

                    + "FROM tbmovimento WHERE dtVcto BETWEEN ? AND ? AND dtApr IS NOT NULL;";



            stmtEmprestimosObtidos = con.prepareStatement(queryEmprestimosObtidos);

            stmtEmprestimosObtidos.setString(1, dataIniFormatada);

            stmtEmprestimosObtidos.setString(2, dataFimFormatada);

            rsEmprestimosObtidos = stmtEmprestimosObtidos.executeQuery();



            String queryEmprestimosPagos = "SELECT "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '01' AND classif = '4.008.011' THEN -ABS(Valor) ELSE 0 END), 2) AS janeiro, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '02' AND classif = '4.008.011' THEN -ABS(Valor) ELSE 0 END), 2) AS fevereiro, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '03' AND classif = '4.008.011' THEN -ABS(Valor) ELSE 0 END), 2) AS marco, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '04' AND classif = '4.008.011' THEN -ABS(Valor) ELSE 0 END), 2) AS abril, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '05' AND classif = '4.008.011' THEN -ABS(Valor) ELSE 0 END), 2) AS maio, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '06' AND classif = '4.008.011' THEN -ABS(Valor) ELSE 0 END), 2) AS junho, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '07' AND classif = '4.008.011' THEN -ABS(Valor) ELSE 0 END), 2) AS julho, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '08' AND classif = '4.008.011' THEN -ABS(Valor) ELSE 0 END), 2) AS agosto, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '09' AND classif = '4.008.011' THEN -ABS(Valor) ELSE 0 END), 2) AS setembro, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '10' AND classif = '4.008.011' THEN -ABS(Valor) ELSE 0 END), 2) AS outubro, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '11' AND classif = '4.008.011' THEN -ABS(Valor) ELSE 0 END), 2) AS novembro, "

                    + "ROUND(SUM(CASE WHEN strftime('%m', dtVcto) = '12' AND classif = '4.008.011' THEN -ABS(Valor) ELSE 0 END), 2) AS dezembro, "

                    + "ROUND(SUM(CASE WHEN classif = '4.008.011' THEN -ABS(Valor) ELSE 0 END), 2) AS total_emprestimos_pagos "

                    + "FROM tbmovimento WHERE dtVcto BETWEEN ? AND ? AND dtApr IS NOT NULL;";



            stmtEmprestimosPagos = con.prepareStatement(queryEmprestimosPagos);

            stmtEmprestimosPagos.setString(1, dataIniFormatada);

            stmtEmprestimosPagos.setString(2, dataFimFormatada);

            rsEmprestimosPagos = stmtEmprestimosPagos.executeQuery();



            // === LEITURA DOS DADOS ===

            double[] totaisReceitas = new double[12];

            double[] totaisDespesas = new double[12];

            double[] totaisEmprestimosObtidos = new double[12];

            double[] totaisEmprestimosPagos = new double[12];

            double totalReceitas = 0, totalDespesas = 0, totalEmprestimosObtidos = 0, totalEmprestimosPagos = 0;



            if (rsReceitas.next()) {

                for (int i = 0; i < 12; i++) {

                    totaisReceitas[i] = rsReceitas.getDouble(i + 1);

                    totalReceitas += totaisReceitas[i];

                }

            }

            if (rsDespesas.next()) {

                for (int i = 0; i < 12; i++) {

                    totaisDespesas[i] = rsDespesas.getDouble(i + 1);

                    totalDespesas += totaisDespesas[i];

                }

            }

            if (rsEmprestimosObtidos.next()) {

                for (int i = 0; i < 12; i++) {

                    totaisEmprestimosObtidos[i] = rsEmprestimosObtidos.getDouble(i + 1);

                    totalEmprestimosObtidos += totaisEmprestimosObtidos[i];

                }

            }

            if (rsEmprestimosPagos.next()) {

                for (int i = 0; i < 12; i++) {

                    totaisEmprestimosPagos[i] = rsEmprestimosPagos.getDouble(i + 1);

                    totalEmprestimosPagos += totaisEmprestimosPagos[i];

                }

            }



            // === PREENCHER ARRAYS PARA O GRÁFICO ===

            for (int i = 0; i < 12; i++) {

                receitasMensais[i] = totaisReceitas[i];

                despesasMensais[i] = totaisDespesas[i];

                resultadosMensais[i] = totaisReceitas[i] + totaisDespesas[i];

            }



            // === CÁLCULO ACUMULATIVO ===

            // A base de cálculo para o Saldo de Caixa/Banco (Limpo) e o Saldo de Empréstimo (Passivo)

            // foram carregadas no bloco anterior (período contínuo/futuro) através das variáveis de transporte.

            int mesFim = Integer.parseInt(dataFimFormatada.substring(5, 7));

            int mesInicio = Integer.parseInt(dataIniFormatada.substring(5, 7));



            // Base limpa para a linha "Saldo Anterior" (Caixa/Banco)

            double saldoInicialCaixaBanco = saldoInicialPeriodo; // ? Usa o Saldo Limpo Transportado



            double[] saldoAcumuladoEmprestimo = new double[12];

            double totalResultadoFinal = 0;

            // Define o passivo inicial de empréstimo (Ex: -600.00)

            // Este é o valor vindo do período anterior, que será usado UMA VEZ no primeiro mês.

            double saldoBaseEmprestimo = saldoInicialEmprestimo; // ? Usa o Saldo de Empréstimo Transportado



            double[] saldosIniciais = new double[12];

            double[] saldosFinais = new double[12];

            double[] resultadoFinalPeriodo = new double[12];



            for (int i = 0; i < 12; i++) {

                int mesAtual = i + 1;

                if (mesAtual >= mesInicio && mesAtual <= mesFim) {



                    // CÁLCULO SALDO DE CAIXA/BANCO (Onde o Saldo Anterior aparece)

                    // Usa saldoInicialCaixaBanco (o valor LIMPO) Apenas no primeiro mês.

                    // CALCULA SALDO CAIXA/BANCO (Limpo)

                    saldosIniciais[i] = (mesAtual == mesInicio) ? saldoInicialCaixaBanco : saldosFinais[i - 1]; // Inicia com R$ 233,40



                    double resultadoMes = totaisReceitas[i] + totaisDespesas[i]; // Fluxo de Caixa Mês

                    saldosFinais[i] = saldosIniciais[i] + resultadoMes; // SOMA APENAS COM RESULTADO DE CAIXA/BANCO



                    // ?? CÁLCULO DO SALDO DE EMPRÉSTIMO ACUMULADO

                    double emprestimoMes = (totaisEmprestimosObtidos[i]) + totaisEmprestimosPagos[i];



                    // CALCULA EMPRÉSTIMO ACUMULADO

                    if (i == 0) {

                        saldoAcumuladoEmprestimo[i] = saldoBaseEmprestimo + emprestimoMes; // Inicia com -R$ 600,00

                    } else {

                        // Transporta o saldo final do mês anterior de empréstimo

                        saldoAcumuladoEmprestimo[i] = saldoAcumuladoEmprestimo[i - 1] + emprestimoMes;

                    }



                    // FIM DOS CÁLCULOS

                    saldoFinalMensal[i] = saldosFinais[i]; // Mantém o Saldo de Caixa/Banco



                } else {

                    saldosIniciais[i] = saldosFinais[i] = 0.0;

                    saldoAcumuladoEmprestimo[i] = 0.0;

                }

            }



            double totalSaldoFinal = (mesFim >= mesInicio) ? saldosFinais[mesFim - 1] : saldoInicialPeriodo;



            // =================================================================

            // BLOCO DE TRANSPORTE FINAL (PONTO 3 CORRIGIDO)

            // =================================================================

            if (mesFim >= mesInicio) {

                int indiceFinal = mesFim - 1;



                // 1. Transporta o Saldo Limpo

                saldoTransportado = saldosFinais[indiceFinal]; // ? ATRIBUIÇÃO CORRETA (R$ 233,40)



                // 2. Transporta o Empréstimo Passivo

                saldoTransportadoEmprestimo = saldoAcumuladoEmprestimo[indiceFinal];



            } else {

                // 1. Transporta o Saldo Limpo (Fallback)

                saldoTransportado = saldoInicialPeriodo;



                // 2. Transporta o Empréstimo Passivo (Fallback)

                saldoTransportadoEmprestimo = saldoInicialEmprestimo;

            }

            // =================================================================



            // === SALDO ANTERIOR CORRETO (com efeito dos empréstimos) ===

            Object[] linhaSaldoAnt = new Object[14];

            linhaSaldoAnt[0] = "Saldo Anterior(Cx/Bcos/Poup)S/Empr.";



            double saldoAnteriorTotal = saldoInicialPeriodo; // + saldoInicialEmprestimo; // ? soma limpo + dívida



            for (int i = 0; i < 12; i++) {

                int mesAtual = i + 1;

                if (mesAtual >= mesInicio && mesAtual <= mesFim) {

                    if (mesAtual == mesInicio) {

                        linhaSaldoAnt[i + 1] = dfCurrency.format(saldoAnteriorTotal);

                    } else {

                        // Mostra o acumulado até o mês anterior (limpo + dívida)

                        linhaSaldoAnt[i + 1] = dfCurrency.format(saldosFinais[i - 1] + saldoAcumuladoEmprestimo[i - 1]);



                    }

                } else {

                    linhaSaldoAnt[i + 1] = "";

                }

            }



            // Coluna TOTAL = mesmo valor do primeiro mês (ou do último mês anterior)

            linhaSaldoAnt[13] = dfCurrency.format(saldoAnteriorTotal);



            modelo.addRow(linhaSaldoAnt);

            modelo.addRow(new Object[14]); // linha em branco



            // === PREENCHER CONTAS ===

            while (rs.next()) {

                modelo.addRow(new Object[]{

                    rs.getString("Contas"),

                    dfCurrency.format(rs.getDouble("janeiro")),

                    dfCurrency.format(rs.getDouble("fevereiro")),

                    dfCurrency.format(rs.getDouble("marco")),

                    dfCurrency.format(rs.getDouble("abril")),

                    dfCurrency.format(rs.getDouble("maio")),

                    dfCurrency.format(rs.getDouble("junho")),

                    dfCurrency.format(rs.getDouble("julho")),

                    dfCurrency.format(rs.getDouble("agosto")),

                    dfCurrency.format(rs.getDouble("setembro")),

                    dfCurrency.format(rs.getDouble("outubro")),

                    dfCurrency.format(rs.getDouble("novembro")),

                    dfCurrency.format(rs.getDouble("dezembro")),

                    dfCurrency.format(rs.getDouble("total"))

                });

            }

            modelo.addRow(new Object[14]); // linha em branco



            // === ADICIONAR RECEITAS, DESPESAS, RESULTADO, EMPRÉSTIMOS ===

            modelo.addRow(new Object[]{

                "Receitas",

                dfCurrency.format(totaisReceitas[0]), dfCurrency.format(totaisReceitas[1]), dfCurrency.format(totaisReceitas[2]),

                dfCurrency.format(totaisReceitas[3]), dfCurrency.format(totaisReceitas[4]), dfCurrency.format(totaisReceitas[5]),

                dfCurrency.format(totaisReceitas[6]), dfCurrency.format(totaisReceitas[7]), dfCurrency.format(totaisReceitas[8]),

                dfCurrency.format(totaisReceitas[9]), dfCurrency.format(totaisReceitas[10]), dfCurrency.format(totaisReceitas[11]),

                dfCurrency.format(totalReceitas)

            });

            modelo.addRow(new Object[]{

                "Despesas",

                dfCurrency.format(totaisDespesas[0]), dfCurrency.format(totaisDespesas[1]), dfCurrency.format(totaisDespesas[2]),

                dfCurrency.format(totaisDespesas[3]), dfCurrency.format(totaisDespesas[4]), dfCurrency.format(totaisDespesas[5]),

                dfCurrency.format(totaisDespesas[6]), dfCurrency.format(totaisDespesas[7]), dfCurrency.format(totaisDespesas[8]),

                dfCurrency.format(totaisDespesas[9]), dfCurrency.format(totaisDespesas[10]), dfCurrency.format(totaisDespesas[11]),

                dfCurrency.format(totalDespesas)

            });

            modelo.addRow(new Object[]{

                "Resultado",

                dfCurrency.format(totaisReceitas[0] + totaisDespesas[0]),

                dfCurrency.format(totaisReceitas[1] + totaisDespesas[1]),

                dfCurrency.format(totaisReceitas[2] + totaisDespesas[2]),

                dfCurrency.format(totaisReceitas[3] + totaisDespesas[3]),

                dfCurrency.format(totaisReceitas[4] + totaisDespesas[4]),

                dfCurrency.format(totaisReceitas[5] + totaisDespesas[5]),

                dfCurrency.format(totaisReceitas[6] + totaisDespesas[6]),

                dfCurrency.format(totaisReceitas[7] + totaisDespesas[7]),

                dfCurrency.format(totaisReceitas[8] + totaisDespesas[8]),

                dfCurrency.format(totaisReceitas[9] + totaisDespesas[9]),

                dfCurrency.format(totaisReceitas[10] + totaisDespesas[10]),

                dfCurrency.format(totaisReceitas[11] + totaisDespesas[11]),

                dfCurrency.format(totalReceitas + totalDespesas)

            });

            modelo.addRow(new Object[14]); // linha em branco



            // === ADICIONAR LINHA DE SALDO INICIAL DE EMPRÉSTIMO ===

            Object[] linhaSaldoEmprestimo = new Object[14];

            linhaSaldoEmprestimo[0] = "Saldo Inicial Empréstimo";



            for (int i = 0; i < 12; i++) {

                int mesAtual = i + 1;

                if (mesAtual == mesInicio) {

                    // Força aparecer negativo (mesmo que o valor já seja negativo)

                    double valorExibir = saldoInicialEmprestimo <= 0 ? saldoInicialEmprestimo : -saldoInicialEmprestimo;

                    linhaSaldoEmprestimo[i + 1] = dfCurrency.format(valorExibir);

                } else {

                    linhaSaldoEmprestimo[i + 1] = "";

                }

            }

            linhaSaldoEmprestimo[13] = dfCurrency.format(saldoInicialEmprestimo <= 0 ? saldoInicialEmprestimo : -saldoInicialEmprestimo);

            modelo.addRow(linhaSaldoEmprestimo);



            // === EMPRÉSTIMOS RECEBIDOS (apresentar como negativo) ===

            modelo.addRow(new Object[]{

                "Emprést.Obt.C.Prazo-Recebidos",

                formatarEmprestimoVisual(totaisEmprestimosObtidos[0], true),

                formatarEmprestimoVisual(totaisEmprestimosObtidos[1], true),

                formatarEmprestimoVisual(totaisEmprestimosObtidos[2], true),

                formatarEmprestimoVisual(totaisEmprestimosObtidos[3], true),

                formatarEmprestimoVisual(totaisEmprestimosObtidos[4], true),

                formatarEmprestimoVisual(totaisEmprestimosObtidos[5], true),

                formatarEmprestimoVisual(totaisEmprestimosObtidos[6], true),

                formatarEmprestimoVisual(totaisEmprestimosObtidos[7], true),

                formatarEmprestimoVisual(totaisEmprestimosObtidos[8], true),

                formatarEmprestimoVisual(totaisEmprestimosObtidos[9], true),

                formatarEmprestimoVisual(totaisEmprestimosObtidos[10], true),

                formatarEmprestimoVisual(totaisEmprestimosObtidos[11], true),

                formatarEmprestimoVisual(totalEmprestimosObtidos, true)

            });

            // === EMPRÉSTIMOS PAGOS (apresentar como positivo) ===

            modelo.addRow(new Object[]{

                "Emprést.Obt.C.Prazo-Pagos",

                formatarEmprestimoVisual(totaisEmprestimosPagos[0], true), // true = inverte o sinal (de negativo vira positivo)

                formatarEmprestimoVisual(totaisEmprestimosPagos[1], true),

                formatarEmprestimoVisual(totaisEmprestimosPagos[2], true),

                formatarEmprestimoVisual(totaisEmprestimosPagos[3], true),

                formatarEmprestimoVisual(totaisEmprestimosPagos[4], true),

                formatarEmprestimoVisual(totaisEmprestimosPagos[5], true),

                formatarEmprestimoVisual(totaisEmprestimosPagos[6], true),

                formatarEmprestimoVisual(totaisEmprestimosPagos[7], true),

                formatarEmprestimoVisual(totaisEmprestimosPagos[8], true),

                formatarEmprestimoVisual(totaisEmprestimosPagos[9], true),

                formatarEmprestimoVisual(totaisEmprestimosPagos[10], true),

                formatarEmprestimoVisual(totaisEmprestimosPagos[11], true),

                formatarEmprestimoVisual(totalEmprestimosPagos, true)

            });

            modelo.addRow(new Object[]{

                "Saldo Empréstimos C.Prazo",

                formatarNegativo(saldoAcumuladoEmprestimo[0]),

                formatarNegativo(saldoAcumuladoEmprestimo[1]),

                formatarNegativo(saldoAcumuladoEmprestimo[2]),

                formatarNegativo(saldoAcumuladoEmprestimo[3]),

                formatarNegativo(saldoAcumuladoEmprestimo[4]),

                formatarNegativo(saldoAcumuladoEmprestimo[5]),

                formatarNegativo(saldoAcumuladoEmprestimo[6]),

                formatarNegativo(saldoAcumuladoEmprestimo[7]),

                formatarNegativo(saldoAcumuladoEmprestimo[8]),

                formatarNegativo(saldoAcumuladoEmprestimo[9]),

                formatarNegativo(saldoAcumuladoEmprestimo[10]),

                formatarNegativo(saldoAcumuladoEmprestimo[11]),

                formatarNegativo(saldoAcumuladoEmprestimo[mesFim - 1])

            });

            modelo.addRow(new Object[14]); // linha em branco



            // === SALDO FINAL DO PERÍODO SEM EMPRÉSTIMO (CAIXA/BANCO) ===

            Object[] linhaSaldoFinal = new Object[14];

            // ATENÇÃO: Mudando o nome da linha para refletir a variável 'saldosFinais' (sem empréstimo)

            linhaSaldoFinal[0] = "Saldo Final (Cx/Bcos/Poup)S/Empréstimos";

            double saldoFinalTotalComEmprestimo = 0.0; // Variável para guardar o saldo TOTAL do último mês



            for (int i = 0; i < 12; i++) {

                int mesAtual = i + 1;

                if ((i + 1) >= mesInicio && (i + 1) <= mesFim) {



                    // 1. Linha do Saldo Limpo (Caixa/Banco)

                    linhaSaldoFinal[i + 1] = dfCurrency.format(saldosFinais[i]); // ? Usa o array de Saldo Limpo



                    // 2. Cálculo do Saldo TOTAL (Caixa/Banco Limpo + Empréstimo Acumulado)

                    // O saldo final total de cada mês é a soma dos dois acumulados:

                    //saldoFinalTotalComEmprestimo = saldosFinais[i] + saldoAcumuladoEmprestimo[i];

                    // 3. TRANSPORTE: O valor FINAL que será transportado é o TOTAL (com empréstimo)

                    // Isso deve ser feito APENAS para o último mês do loop, mas vamos calcular 

                    // em cada iteração e o último valor prevalecerá.

                    //pegaSaldoFinal = saldoFinalTotalComEmprestimo;

                    //saldoTransportado = pegaSaldoFinal;

                } else {

                    linhaSaldoFinal[i + 1] = "";

                }

            }



            // O total é o Saldo Final Total LIMPO do último mês do período calculado

            linhaSaldoFinal[13] = dfCurrency.format(saldosFinais[mesFim - 1]);

            modelo.addRow(linhaSaldoFinal);



            // === SALDO TOTAL DISPONÍVEL (com efeito dos empréstimos) ===

            Object[] linhaSaldoTotal = new Object[14];

            linhaSaldoTotal[0] = "Saldo Total Dispon�vel(C/Empréstimos)";



            for (int i = 0; i < 12; i++) {

                int mesAtual = i + 1;

                if (mesAtual >= mesInicio && mesAtual <= mesFim) {

                    double saldoLimpo = saldosFinais[i] + saldoAcumuladoEmprestimo[i];

                    linhaSaldoTotal[i + 1] = dfCurrency.format(saldoLimpo);

                } else {

                    linhaSaldoTotal[i + 1] = "";

                }

            }

            linhaSaldoTotal[13] = dfCurrency.format(saldosFinais[mesFim - 1] + saldoAcumuladoEmprestimo[mesFim - 1]);

            modelo.addRow(linhaSaldoTotal);



            // TRANSPORTE CORRETO PARA O PRÓXIMO PERÍODO

            double saldoTotalFinal = saldosFinais[mesFim - 1] + saldoAcumuladoEmprestimo[mesFim - 1];



            // === TRANSPORTE CORRETO (APENAS O SALDO PRÓPRIO) ===

            saldoTransportado = saldosFinais[mesFim - 1];                    // ? 233,40  (só o que é realmente seu)

            saldoTransportadoEmprestimo = saldoAcumuladoEmprestimo[mesFim - 1]; // ? ?600,00 (só para mostrar na tela)



            // === CORES NA TABELA ===

            ColorearTabla colorearTabla = new ColorearTabla();

            for (int i = 1; i < jTablePesquisa.getColumnCount(); i++) {

                jTablePesquisa.getColumnModel().getColumn(i).setCellRenderer(colorearTabla);

            }



        } catch (SQLException | ParseException ex) {

            Logger.getLogger(Tela_Consulta_RC.class.getName()).log(Level.SEVERE, null, ex);

            JOptionPane.showMessageDialog(null, "Erro ao consultar dados: " + ex.getMessage());

        } finally {

            try {

                if (rs != null) {

                    rs.close();

                }

                if (stmt != null) {

                    stmt.close();

                }

                if (rsReceitas != null) {

                    rsReceitas.close();

                }

                if (stmtReceitas != null) {

                    stmtReceitas.close();

                }

                if (rsDespesas != null) {

                    rsDespesas.close();

                }

                if (stmtDespesas != null) {

                    stmtDespesas.close();

                }

                if (rsEmprestimosObtidos != null) {

                    rsEmprestimosObtidos.close();

                }

                if (stmtEmprestimosObtidos != null) {

                    stmtEmprestimosObtidos.close();

                }

                if (rsEmprestimosPagos != null) {

                    rsEmprestimosPagos.close();

                }

                if (stmtEmprestimosPagos != null) {

                    stmtEmprestimosPagos.close();

                }

                if (rsSaldo != null) {

                    rsSaldo.close();

                }

                if (stmtSaldo != null) {

                    stmtSaldo.close();

                }

                if (con != null) {

                    con.close();

                }

            } catch (SQLException e) {

                Logger.getLogger(Tela_Consulta_RC.class.getName()).log(Level.SEVERE, null, e);

            }

            conexao.fecharConexao();

        }

    }//GEN-LAST:event_jButtonPesquisarActionPerformed



    private String formatarNegativo(double valor) {

        // === FORMATADOR DE MOEDA ===

        DecimalFormatSymbols symbols = new DecimalFormatSymbols();

        symbols.setDecimalSeparator(',');

        symbols.setGroupingSeparator('.');

        DecimalFormat dfCurrency = new DecimalFormat("#,##0.00", symbols);



        double valorExibir = (valor <= 0) ? valor : -valor;  // força negativo



        String formatado = dfCurrency.format(valorExibir);

        // Se quiser em vermelho (funciona com JTable + HTML)

        //return "<html><font color=" + (valorExibir < 0 ? "red" : "green") + ">" + formatado + "</font></html>";

        // Ou sem cor (só negativo):

        return dfCurrency.format(valorExibir);

    }



    // Só para deixar os empréstimos com sinal invertido na tela

    private String formatarEmprestimoVisual(double valor, boolean inverterSinal) {



//        // === FORMATADOR DE MOEDA ===

        DecimalFormatSymbols symbols = new DecimalFormatSymbols();

        DecimalFormatSymbols br = new DecimalFormatSymbols(new Locale.Builder().setLanguage("pt").setRegion("BR").build());

        br.setDecimalSeparator(',');

        br.setGroupingSeparator('.');

        symbols.setDecimalSeparator(',');

        symbols.setGroupingSeparator('.');

        DecimalFormat dfCurrency = new DecimalFormat("#,##0.00", symbols);

        DecimalFormat dfNumero = new DecimalFormat("#,##0.00", br);

        double valorExibir = inverterSinal ? -valor : valor;

        return dfNumero.format(valorExibir);  // ? só retorna " -1.300,00 " ou " 700,00 "

    }



    private void jButtonPLimparActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_jButtonPLimparActionPerformed

        ((DefaultTableModel) jTablePesquisa.getModel()).setRowCount(0);

        jFormattedTextFieldDataIni.setText("");

        jFormattedTextFieldDataFim.setText("");

    }//GEN-LAST:event_jButtonPLimparActionPerformed



    private void jButtonPImprimirActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_jButtonPImprimirActionPerformed

        DateFormat dateFormat = new SimpleDateFormat("dd/MM/yyyy HH:mm");

        Date date = new Date();

        String infDt = dateFormat.format(date);



        // Pegar as datas dos campos

        String dataInicial = jFormattedTextFieldDataIni.getText();

        String dataFinal = jFormattedTextFieldDataFim.getText();



        PrintRequestAttributeSet set = new HashPrintRequestAttributeSet();

        set.add(OrientationRequested.LANDSCAPE);



        MessageFormat cabecalho = new MessageFormat(

                "Referência Cruzada - Período: " + dataInicial + " a " + dataFinal);



        MessageFormat rodape = new MessageFormat(

                "Página {0,number,integer}" + " - Impressão: " + infDt);



        try {

            jTablePesquisa.print(JTable.PrintMode.FIT_WIDTH, cabecalho, rodape, false, set, false);

        } catch (java.awt.print.PrinterException e) {

            System.err.format("Erro ao imprimir!!! %s%n", e.getMessage());

        }

    }//GEN-LAST:event_jButtonPImprimirActionPerformed





    private void jButtonGraficoActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_jButtonGraficoActionPerformed

        try {

            // Verifica se há dados

            boolean temDados = false;

            for (int i = 0; i < 12; i++) {

                if (receitasMensais[i] != 0 || despesasMensais[i] != 0 || saldoFinalMensal[i] != 0) {

                    temDados = true;

                    break;

                }

            }



            if (temDados) {

                XYLineChart graf = new XYLineChart(receitasMensais, despesasMensais, resultadosMensais);

            } else {

                JOptionPane.showMessageDialog(this, "Não há dados para exibir no gráfico.");

            }

        } catch (Exception ex) {

            Logger.getLogger(Tela_Consulta_RC.class.getName()).log(Level.SEVERE, null, ex);

            JOptionPane.showMessageDialog(this, "Erro ao gerar gráfico: " + ex.getMessage());

        }



    }//GEN-LAST:event_jButtonGraficoActionPerformed



    private void jButtonExportarActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_jButtonExportarActionPerformed

        JFileChooser fileChooser = new JFileChooser();

        fileChooser.setDialogTitle("Salvar como...");

        int userSelection = fileChooser.showSaveDialog(null);



        if (userSelection == JFileChooser.APPROVE_OPTION) {

            String path = fileChooser.getSelectedFile().getAbsolutePath();

            if (!path.endsWith(".xlsx")) {

                path += ".xlsx";

            }

            try {

                ExportToExcel exporter = new ExportToExcel();

                exporter.exportTable(jTablePesquisa, path);

                JOptionPane.showMessageDialog(null, "Arquivo Excel " + path + " foi gerado com sucesso!");

            } catch (IOException e) {

                e.printStackTrace();

                JOptionPane.showMessageDialog(null, "Erro ao exportar: " + e.getMessage());

            }

        }

    }//GEN-LAST:event_jButtonExportarActionPerformed



    private void jButtonAnualActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_jButtonAnualActionPerformed

        // Obtém o ano atual

        int anoCorrente = java.time.Year.now().getValue();



        // Define as datas de início e fim do ano

        String dataInicial = "01/01/" + anoCorrente;

        String dataFinal = "31/12/" + anoCorrente;



        // Preenche os campos de data

        jFormattedTextFieldDataIni.setText(dataInicial);

        jFormattedTextFieldDataFim.setText(dataFinal);

    }//GEN-LAST:event_jButtonAnualActionPerformed

