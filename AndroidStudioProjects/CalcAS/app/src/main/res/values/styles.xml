<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalcButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CalcButtonDefault" parent="CalcButtonBase">
        <item name="android:background">@drawable/btn_pressed</item>
        <item name="android:textColor">@color/button_text</item>
    </style>

    <style name="CalcButtonScientific" parent="CalcButtonBase">
        <item name="android:background">@drawable/btn_scientific</item>
        <item name="android:textColor">@color/btn_scientific_text</item>
    </style>

    <style name="CalcButtonClear" parent="CalcButtonBase">
        <item name="android:background">@drawable/btn_clear</item>
        <item name="android:textColor">@color/btn_clear_text</item>
    </style>

    <style name="CalcButtonEqual" parent="CalcButtonBase">
        <item name="android:background">@drawable/btn_equal</item>
        <item name="android:textColor">@color/btn_equal_text</item>
    </style>

    <style name="CalcButtonOp" parent="CalcButtonBase">
        <item name="android:background">@drawable/btn_op</item>
        <item name="android:textColor">@color/btn_op_text</item>
    </style>

    <style name="CalcButtonDel" parent="CalcButtonBase">
        <item name="android:background">@drawable/btn_del</item>
        <item name="android:textColor">@color/btn_del_text</item>
    </style>
</resources>
