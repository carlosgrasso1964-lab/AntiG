<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:left="0dp"
                android:top="3dp"
                android:right="0dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_bg" />
                    <corners android:radius="24dp" />
                    <stroke android:width="1dp" android:color="#eef5ff" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_enabled="true">
        <layer-list>
            <item
                android:left="0dp"
                android:top="0dp"
                android:right="0dp"
                android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/shadow_color" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_bg" />
                    <corners android:radius="22dp" />
                    <stroke android:width="1dp" android:color="#eef5ff" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
