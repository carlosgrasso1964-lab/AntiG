<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_equal_text" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <layer-list>
            <item
                android:left="0dp"
                android:top="0dp"
                android:right="0dp"
                android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/equal_shadow" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/btn_equal_bg" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
