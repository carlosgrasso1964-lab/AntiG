<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIdMov"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="ID"
            android:textSize="12sp"
            android:paddingEnd="4dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvRecurso"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Recurso"
            android:textSize="12sp"
            android:paddingEnd="4dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvClifor"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Cli/For"
            android:textSize="12sp"
            android:paddingEnd="4dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvDtEmi"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Emissão"
            android:textSize="12sp"
            android:gravity="end"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvDtVcto"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Vencimento"
            android:textSize="12sp"
            android:paddingEnd="4dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvDiaSemana"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Dia"
            android:textSize="12sp"
            android:paddingEnd="4dp"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvDocumento"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:text="Documento"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvDescr"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:text="Descrição"
            android:textSize="12sp"
            android:paddingEnd="4dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvValor"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Valor"
            android:textSize="12sp"
            android:paddingEnd="4dp"
            android:gravity="end"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvPrev"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Prev"
            android:textSize="12sp"
            android:paddingEnd="4dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvSaldo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Saldo"
            android:textSize="12sp"
            android:gravity="end"
            android:ellipsize="end"
            android:maxLines="1" />

    </LinearLayout>

</LinearLayout>