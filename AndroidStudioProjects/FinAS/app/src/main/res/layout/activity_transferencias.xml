<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_data_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Data:"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/edt_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="dd/MM/yyyy"
        android:inputType="date"
        android:maxLength="10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_data_label"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tv_documento_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Documento:"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edt_data"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/edt_documento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Ex.: TRANSF"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_documento_label"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tv_origem_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Origem:"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edt_documento"
        android:layout_marginTop="16dp" />

    <Spinner
        android:id="@+id/spinner_origem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_origem_label"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tv_origem_codigo_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Código Origem:"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinner_origem"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/edt_origem_codigo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:inputType="none"
        android:enabled="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/edt_origem_classif"
        app:layout_constraintTop_toBottomOf="@id/tv_origem_codigo_label"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/edt_origem_classif"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:inputType="none"
        android:enabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/edt_origem_codigo"
        app:layout_constraintTop_toBottomOf="@id/tv_origem_codigo_label"
        android:layout_marginStart="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_destino_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Destino:"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edt_origem_codigo"
        android:layout_marginTop="16dp" />

    <Spinner
        android:id="@+id/spinner_destino"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_destino_label"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tv_destino_codigo_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Código Destino:"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinner_destino"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/edt_destino_codigo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:inputType="none"
        android:enabled="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/edt_destino_classif"
        app:layout_constraintTop_toBottomOf="@id/tv_destino_codigo_label"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/edt_destino_classif"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:inputType="none"
        android:enabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/edt_destino_codigo"
        app:layout_constraintTop_toBottomOf="@id/tv_destino_codigo_label"
        android:layout_marginStart="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_valor_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Valor:"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edt_destino_codigo"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/edt_valor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Ex.: 123,45"
        android:inputType="numberDecimal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_valor_label"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_transferir"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Transferir"
        app:layout_constraintEnd_toStartOf="@id/btn_fechar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edt_valor"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btn_fechar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Fechar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_transferir"
        app:layout_constraintTop_toBottomOf="@id/edt_valor"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>