<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Consulta de Favorecidos"
        android:textSize="24sp"
        android:gravity="center"
        android:padding="16dp" />

    <Spinner
        android:id="@+id/spinnerFavorecidos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/edtNrFav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Código do Favorecido"
        android:inputType="text"
        android:enabled="false"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/edtFavorecidos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Grupo do Favorecido"
        android:inputType="text"
        android:enabled="false"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/edtNomeCli"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome do Favorecido"
        android:inputType="text"
        android:enabled="false"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- LinearLayout horizontal para Data Inicial e Data Final -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edtDataIni"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:hint="Data Inicial (dd/MM/yyyy)"
            android:inputType="date" />

        <EditText
            android:id="@+id/edtDataFim"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:hint="Data Final (dd/MM/yyyy)"
            android:inputType="date" />

    </LinearLayout>

    <EditText
        android:id="@+id/edtSaldoAnterior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Saldo Anterior"
        android:inputType="numberDecimal"
        android:enabled="false"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnPesquisar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pesquisar"
            android:layout_marginEnd="8dp"
            android:padding="8dp" />

        <Button
            android:id="@+id/btnLimpar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Limpar"
            android:layout_marginEnd="8dp"
            android:padding="8dp" />

        <Button
            android:id="@+id/btnImprimir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Imprimir"
            android:padding="8dp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewResultados"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="?attr/actionBarSize" />

</LinearLayout>