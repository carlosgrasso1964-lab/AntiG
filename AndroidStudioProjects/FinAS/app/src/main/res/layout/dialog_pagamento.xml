<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@android:color/black">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Pagar Lançamento"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white" />

    <Spinner
        android:id="@+id/spinner_recurso_pagamento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:prompt="@string/prompt_recurso"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@android:color/white"
        android:spinnerMode="dropdown" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data de Pagamento"
        android:textSize="14sp"
        android:textColor="@android:color/white" />

    <EditText
        android:id="@+id/edt_data_pagamento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Data de Pagamento"
        android:inputType="date"
        android:ellipsize="end"
        android:singleLine="true"
        android:layout_marginBottom="8dp"
        android:textColor="@android:color/white"
        android:textColorHint="@android:color/darker_gray"
        android:backgroundTint="@android:color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Valor Pago (R$)"
        android:textSize="14sp"
        android:textColor="@android:color/white" />

    <EditText
        android:id="@+id/edt_valor_pago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Valor Pago (R$)"
        android:inputType="numberDecimal"
        android:ellipsize="end"
        android:singleLine="true"
        android:layout_marginBottom="8dp"
        android:textColor="@android:color/white"
        android:textColorHint="@android:color/darker_gray"
        android:backgroundTint="@android:color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desconto (R$)"
        android:textSize="14sp"
        android:textColor="@android:color/white" />

    <EditText
        android:id="@+id/edt_desconto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Desconto (R$)"
        android:inputType="numberDecimal"
        android:ellipsize="end"
        android:singleLine="true"
        android:layout_marginBottom="8dp"
        android:textColor="@android:color/white"
        android:textColorHint="@android:color/darker_gray"
        android:backgroundTint="@android:color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Juros (R$)"
        android:textSize="14sp"
        android:textColor="@android:color/white" />

    <EditText
        android:id="@+id/edt_juros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Juros (R$)"
        android:inputType="numberDecimal"
        android:ellipsize="end"
        android:singleLine="true"
        android:layout_marginBottom="8dp"
        android:textColor="@android:color/white"
        android:textColorHint="@android:color/darker_gray"
        android:backgroundTint="@android:color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_cancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textColor="@android:color/black"
            android:backgroundTint="@android:color/white" />

        <Button
            android:id="@+id/btn_confirmar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirmar"
            android:textColor="@android:color/black"
            android:backgroundTint="@android:color/white" />
    </LinearLayout>
</LinearLayout>