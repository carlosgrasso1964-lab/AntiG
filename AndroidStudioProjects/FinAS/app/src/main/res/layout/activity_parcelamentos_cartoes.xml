<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parcelamento - Cartões"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Spinner
        android:id="@+id/spinnerTipoOperacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinnerRecurso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerTipoOperacao"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinnerClifor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerRecurso"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinnerClassif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerClifor"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/edtDtEmi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Data de Emissão (dd/mm/aaaa)"
        android:inputType="date"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerClassif"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/edtDtVcto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Data de Vencimento (dd/mm/aaaa)"
        android:inputType="date"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/edtDtEmi"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/edtDocumento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Documento"
        android:inputType="text"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/edtDtVcto"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/edtDescricao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descrição"
        android:inputType="text"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/edtDocumento"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/edtValorTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Valor Total (R$)"
        android:inputType="numberDecimal"
        android:digits="0123456789,."
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/edtDescricao"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/edtValorParcela"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Valor da Parcela (R$)"
        android:inputType="numberDecimal"
        android:layout_marginTop="8dp"
        android:enabled="false"
        app:layout_constraintTop_toBottomOf="@id/edtValorTotal"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinnerNumParcelas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/edtValorParcela"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinnerPeriodicidade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerNumParcelas"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinnerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerPeriodicidade"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinnerPrev"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerStatus"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnGerar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gerar"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerPrev"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnLimpar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Limpar"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerPrev"
        app:layout_constraintStart_toEndOf="@id/btnGerar"
        app:layout_constraintEnd_toStartOf="@id/btnFechar" />

    <Button
        android:id="@+id/btnFechar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fechar"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerPrev"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>